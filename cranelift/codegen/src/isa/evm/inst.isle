;; EVM instruction definitions for ISLE.

;; The main instruction type.
(type MInst
  (enum
    (Nop)
    (Stop)
    (Push (imm ImmBytes))
    (Pop)
    (Dup (depth u8))
    (Swap (depth u8))
    (Add)
    (Mul)
    (Sub)
    (Div)
    (SDiv)
    (Mod)
    (SMod)
    (AddMod)
    (MulMod)
    (Exp)
    (SignExtend)
    (Lt)
    (Gt)
    (SLt)
    (SGt)
    (Eq)
    (IsZero)
    (And)
    (Or)
    (Xor)
    (Not)
    (Byte)
    (Shl)
    (Shr)
    (Sar)
    (Keccak256)
    (MLoad)
    (MStore)
    (MStore8)
    (SLoad)
    (SStore)
    (Jump (target MachLabel))
    (JumpI (target MachLabel))
    (JumpDest)
    (Pc)
    (MSize)
    (Gas)
    (Return)
    (Revert)
    (Invalid)
    (SelfDestruct)
    (Address)
    (Balance)
    (Origin)
    (Caller)
    (CallValue)
    (CallDataLoad)
    (CallDataSize)
    (CallDataCopy)
    (CodeSize)
    (CodeCopy)
    (GasPrice)
    (ExtCodeSize)
    (ExtCodeCopy)
    (ReturnDataSize)
    (ReturnDataCopy)
    (ExtCodeHash)
    (BlockHash)
    (Coinbase)
    (Timestamp)
    (Number)
    (PrevRandao)
    (GasLimit)
    (ChainId)
    (SelfBalance)
    (BaseFee)
    (Log (topic_count u8))
    (Call)
    (CallCode)
    (DelegateCall)
    (StaticCall)
    (Create)
    (Create2)
    (TLoad)
    (TStore)
    (MCopy)
    (BlobHash)
    (BlobBaseFee)
    (Trap (code TrapCode))
    (Udf (code TrapCode))
  )
)

;; Helper type for 256-bit immediate bytes.
(type ImmBytes extern (enum))

;; Helper constructor for binary operations.
(decl evm_binary_op (MInst Type Value Value) InstOutput)
(extern constructor evm_binary_op evm_binary_op)

;; Helper constructor for unary operations.
(decl evm_unary_op (MInst Type Value) InstOutput)
(extern constructor evm_unary_op evm_unary_op)

;; Helper constructor for trap.
(decl evm_trap (TrapCode) InstOutput)
(extern constructor evm_trap evm_trap)

;; Helper constructor for immediates.
(decl imm (Type u64) InstOutput)
(extern constructor imm imm)
