; Test i256 comparison operations
function %i256_compare(i256, i256) -> i8 {
block0(v0: i256, v1: i256):
    v2 = icmp eq v0, v1
    v3 = icmp ne v0, v1
    v4 = icmp slt v0, v1
    v5 = icmp ult v0, v1
    return v2
}
