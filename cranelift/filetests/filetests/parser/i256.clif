; Test i256 bitwise operations
function %i256_bitwise(i256, i256) -> i256 {
block0(v0: i256, v1: i256):
    v2 = band v0, v1
    v3 = bor v0, v1
    v4 = bxor v0, v1
    v5 = bnot v0
    return v2
}
