; Test i256 arithmetic operations
function %i256_arithmetic(i256, i256) -> i256 {
block0(v0: i256, v1: i256):
    v2 = iadd v0, v1
    v3 = isub v0, v1
    v4 = imul v0, v1
    return v2
}
