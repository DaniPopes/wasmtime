test run
set preserve_frame_pointers=true
target x86_64
target aarch64

;; Tail calls between functions with different numbers of stack arguments take no stack space.
function %loop(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tailcc {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tailcc
    fn0 = colocated %loop_shrunk sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64, v11: i64):
    brif v0, block1, block2

block1:
    v12 = iconst.i64 -1
    v13 = iadd v0, v12
    v14 = iadd v1, v11
    v15 = iadd v10, v8
    return_call fn0(v13, v14, v2, v3, v4, v5, v6, v7, v9, v15)

block2:
    v16 = iadd v1, v10
    v17 = iadd v16, v11
    return v17
}

function %loop_shrunk(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tailcc {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tailcc
    fn0 = colocated %loop sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64):
    v10 = iconst.i64 3
    v11 = iadd v9, v10
    return_call fn0(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v11, v8)
}

function %main() -> i64 {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 tailcc
    fn0 = colocated %loop sig0
block0:
    v0 = iconst.i64 1000000
    v1 = iconst.i64 0
    v2 = iconst.i64 5
    v3 = call fn0(v0, v1, v1, v1, v1, v1, v1, v1, v2, v2, v2, v2)
    return v3
}
