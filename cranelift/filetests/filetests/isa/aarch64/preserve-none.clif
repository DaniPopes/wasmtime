test compile precise-output
set preserve_frame_pointers=true
set unwind_info=false
target aarch64

;; The integer arguments are passed in x20-x28, x0-x7, x10-x14, x9 and x15.
function %args(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 preserve_none {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64, v11: i64, v12: i64, v13: i64, v14: i64, v15: i64, v16: i64, v17: i64, v18: i64, v19: i64, v20: i64, v21: i64, v22: i64, v23: i64, v24: i64, v25: i64):
    v26 = iadd v0, v22
    v27 = iadd v26, v23
    v28 = iadd v27, v25
    return v28
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
; block0:
;   ldr x4, [sp, #24]
;   add x8, x20, x9
;   add x8, x8, x15
;   add x0, x8, x4
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x8
;   ldur x4, [sp, #0x18]
;   add x8, x20, x9
;   add x8, x8, x15
;   add x0, x8, x4
;   ldp x29, x30, [sp], #0x10
;   ret

;; Tail calls reuse the incoming stack arguments and leave them to the caller to pop.
function %tail(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 preserve_none {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 preserve_none
    fn0 = colocated %args sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64, v11: i64, v12: i64, v13: i64, v14: i64, v15: i64, v16: i64, v17: i64, v18: i64, v19: i64, v20: i64, v21: i64, v22: i64, v23: i64, v24: i64, v25: i64):
    v26 = iadd v25, v0
    return_call fn0(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v26)
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
; block0:
;   ldr x8, [sp, #16]
;   ldr x19, [sp, #24]
;   add x19, x19, x20
;   str x8, [sp, #16]
;   str x19, [sp, #24]
;   return_call TestCase(%args) new_stack_arg_size:16 x20=x20 x21=x21 x22=x22 x23=x23 x24=x24 x25=x25 x26=x26 x27=x27 x28=x28 x0=x0 x1=x1 x2=x2 x3=x3 x4=x4 x5=x5 x6=x6 x7=x7 x10=x10 x11=x11 x12=x12 x13=x13 x14=x14 x9=x9 x15=x15
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x8
;   ldur x8, [sp, #0x10]
;   ldur x19, [sp, #0x18]
;   add x19, x19, x20
;   stur x8, [sp, #0x10]
;   stur x19, [sp, #0x18]
;   ldp x29, x30, [sp], #0x10
;   b #0x20 ; reloc_external Call %args 0


;; The callee of an indirect tail call is not in an argument register.
function %tail_indirect(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) preserve_none {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) preserve_none
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64, v11: i64):
    return_call_indirect sig0, v11(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11)
}

