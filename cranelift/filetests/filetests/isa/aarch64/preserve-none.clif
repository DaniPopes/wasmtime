;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x8
;   ldur x4, [sp, #0x18]
;   add x8, x20, x9
;   add x8, x8, x15
;   add x0, x8, x4
;   ldp x29, x30, [sp], #0x10
;   ret
