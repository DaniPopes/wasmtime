;   blr x5
;   mov x1, x19
;   add x0, x0, x1
;   ldp d8, d9, [sp], #16
;   ldp d10, d11, [sp], #16
;   ldp d12, d13, [sp], #16
;   ldp d14, d15, [sp], #16
;   ldp x9, x10, [sp], #16
;   ldp x11, x12, [sp], #16
;   ldp x13, x14, [sp], #16
;   ldp x15, x19, [sp], #16
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
;   stp x15, x19, [sp, #-0x10]!
;   stp x13, x14, [sp, #-0x10]!
;   stp x11, x12, [sp, #-0x10]!
;   stp x9, x10, [sp, #-0x10]!
;   stp d14, d15, [sp, #-0x10]!
;   stp d12, d13, [sp, #-0x10]!
;   stp d10, d11, [sp, #-0x10]!
;   stp d8, d9, [sp, #-0x10]!
; block1: ; offset 0x28
;   mov x19, x1
;   ldr x5, #0x34
;   b #0x3c
;   udf #0 ; reloc_external Abs8 %other 0
;   udf #0
;   blr x5
;   mov x1, x19
;   add x0, x0, x1
;   ldp d8, d9, [sp], #0x10
;   ldp d10, d11, [sp], #0x10
;   ldp d12, d13, [sp], #0x10
;   ldp d14, d15, [sp], #0x10
;   ldp x9, x10, [sp], #0x10
;   ldp x11, x12, [sp], #0x10
;   ldp x13, x14, [sp], #0x10
;   ldp x15, x19, [sp], #0x10
;   ldp x29, x30, [sp], #0x10
;   ret

;; A tail call jumps to a register that the callee-save restore code does not touch.
function %tail_indirect(i64, i64) -> i64 preserve_most {
    sig0 = (i64) -> i64 preserve_most
block0(v0: i64, v1: i64):
    return_call_indirect sig0, v1(v0)
}

