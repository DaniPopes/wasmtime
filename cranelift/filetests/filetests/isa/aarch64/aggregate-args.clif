test compile precise-output
set unwind_info=false
target aarch64

;; Only `x7` is left for the aggregate of two parameters, so all of it goes on
;; the stack, and the next argument goes on the stack too.
function u0:0(i64, i64, i64, i64, i64, i64, i64, i64 aggregate(2, 8), i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64):
    return v9
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
; block0:
;   ldr x0, [sp, #32]
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x8
;   ldur x0, [sp, #0x20]
;   ldp x29, x30, [sp], #0x10
;   ret

;; An aggregate that fits starts at the next register, even if it has an
;; alignment of 16.
function u0:1(i64, i64 aggregate(2, 16), i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    return v3
}

; VCode:
; block0:
;   mov x0, x3
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   mov x0, x3
;   ret

;; A float aggregate that does not fit in the vector registers goes on the
;; stack, packed like in memory, and so do the later float arguments.
function u0:2(f32, f32, f32, f32, f32, f32, f32, f32 aggregate(3, 4), f32, f32, f32) -> f32 {
block0(v0: f32, v1: f32, v2: f32, v3: f32, v4: f32, v5: f32, v6: f32, v7: f32, v8: f32, v9: f32, v10: f32):
    return v10
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
; block0:
;   ldr s0, [sp, #32]
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x8
;   ldur s0, [sp, #0x20]
;   ldp x29, x30, [sp], #0x10
;   ret


;; On Apple platforms the parts of an aggregate on the stack are aligned like the
;; aggregate and not rounded up to 8 bytes: here `v13` follows `v12` directly.
function u0:3(f64, f64, f64, f64, f64, f64, f64, f64, i64, i64, i64, i64, i64, i64, i64, i64, i8, f32 aggregate(3, 4), f32, f32, i8, i32) -> i32 apple_aarch64 {
block0(v0: f64, v1: f64, v2: f64, v3: f64, v4: f64, v5: f64, v6: f64, v7: f64, v8: i64, v9: i64, v10: i64, v11: i64, v12: i64, v13: i64, v14: i64, v15: i64, v16: i8, v17: f32, v18: f32, v19: f32, v20: i8, v21: i32):
    return v21
}

; VCode:
;   stp fp, lr, [sp, #-16]!
;   mov fp, sp
; block0:
;   ldr w0, [sp, #36]
;   ldp fp, lr, [sp], #16
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   stp x29, x30, [sp, #-0x10]!
;   mov x29, sp
; block1: ; offset 0x8
;   ldur w0, [sp, #0x24]
;   ldp x29, x30, [sp], #0x10
;   ret

