test compile precise-output
set preserve_frame_pointers=true
set enable_probestack=true
set probestack_strategy=inline
target x86_64

;; The probe loop does not use `r11`, which holds the eleventh argument.
function %probe(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 preserve_none {
    ss0 = explicit_slot 40000
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64):
    v11 = stack_addr.i64 ss0
    store.i64 v10, v11
    return v0
}

