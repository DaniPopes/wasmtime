test compile precise-output
target x86_64

;; System V passes an upper bound of the vector registers used by a variadic call in `al`.
function %variadic_call(i64, f64, f64) system_v {
    sig0 = (i64, i64, f64, f64) -> i32 variadic system_v
    sig1 = (i64) -> i32 system_v
    fn0 = %printf sig0
    fn1 = %puts sig1
block0(v0: i64, v1: f64, v2: f64):
    v3 = call fn0(v0, v0, v1, v2)
    v4 = call fn1(v0)
    return
}

