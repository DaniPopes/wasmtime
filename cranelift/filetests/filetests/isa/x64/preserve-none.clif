test compile precise-output
set preserve_frame_pointers=true
target x86_64

;; The arguments are passed in r12, r13, r14, r15, rdi, rsi, rdx, rcx, r8, r9, r11 and rax, and
;; everything but the frame pointer is clobbered by a call.
function %args(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 preserve_none {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64, v11: i64, v12: i64):
    v13 = iadd v0, v11
    v14 = iadd v13, v12
    return v14
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movq <offset:0>+-0x10(%rbp), %rsi
;   leaq (%r12, %rax), %rdi
;   leaq (%rdi, %rsi), %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movq 0x10(%rbp), %rsi
;   leaq (%r12, %rax), %rdi
;   leaq (%rdi, %rsi), %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

;; Tail calls reuse the incoming stack arguments and leave them to the caller to pop.
function %tail(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 preserve_none {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> i64 preserve_none
    fn0 = colocated %args sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64, v11: i64, v12: i64):
    v13 = iadd v12, v0
    return_call fn0(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v13)
}

