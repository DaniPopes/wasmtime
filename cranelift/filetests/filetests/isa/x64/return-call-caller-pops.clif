;   jmp 0x1d ; reloc_external CallPCRel4 %system_v -4

function %system_v_indirect(i64, i64, i64, i64, i64, i64, i64, i64) -> i64 system_v {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64) -> i64 system_v
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64):
    return_call_indirect sig0, v0(v0, v1, v2, v3, v4, v5, v6, v7)
}

