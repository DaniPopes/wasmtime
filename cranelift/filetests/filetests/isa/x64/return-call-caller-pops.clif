test compile precise-output
set preserve_frame_pointers=true
target x86_64

;; A tail call in a convention where the caller pops the stack arguments writes the arguments of
;; the callee over the ones of the caller and does not pop them.
function %system_v(i64, i64, i64, i64, i64, i64, i64, i64) -> i64 system_v {
    sig0 = (i64, i64, i64, i64, i64, i64, i64, i64) -> i64 system_v
    fn0 = colocated %system_v sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64):
    return_call fn0(v0, v1, v2, v3, v4, v5, v7, v6)
}

