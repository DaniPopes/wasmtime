test compile precise-output
target x86_64

;; Only `r9` is left for the aggregate of two parameters, so all of it goes on
;; the stack, 16-byte aligned, and `r9` stays available to the next argument.
function u0:0(i64, i64, i64, i64, i64, i64 aggregate(2, 16), i64, i64) -> i64 system_v {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64):
    return v7
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movq %r9, %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movq %r9, %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

;; The same for a float aggregate when too few vector registers are left.
function u0:1(f64, f64, f64, f64, f64, f64, f64, f64 aggregate(2, 8), f64, f64) -> f64 system_v {
block0(v0: f64, v1: f64, v2: f64, v3: f64, v4: f64, v5: f64, v6: f64, v7: f64, v8: f64, v9: f64):
    return v9
}

