; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movabsq $0, %r10 ; reloc_external Abs8 %callee 0
;   callq *%r10
;   leaq (%rdi, %rsi), %r11
;   leaq (%rdx, %rcx), %rax
;   addq %rax, %r11
;   leaq (%r11, %r8), %rax
;   movq %rbp, %rsp
;   popq %rbp
;   retq

function %callee(i64, i64, i64, i64, i64, i64) -> i64 preserve_most {
    sig0 = (i64) -> i64 system_v
    fn0 = %other sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6 = call fn0(v0)
    v7 = iadd v6, v1
    v8 = iadd v2, v3
    v9 = iadd v8, v4
    v10 = iadd v9, v5
    v11 = iadd v10, v7
    return v11
}

