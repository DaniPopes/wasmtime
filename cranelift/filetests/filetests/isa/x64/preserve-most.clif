;; The return registers are not preserved.
function %callee_void(i64, i64) preserve_most {
    sig0 = (i64) -> i64 system_v
    fn0 = %other sig0
block0(v0: i64, v1: i64):
    v2 = call fn0(v0)
    v3 = call fn0(v1)
    return
}

