test compile precise-output
set preserve_frame_pointers=true
target x86_64

;; A call to a `preserve_most` function keeps the values in all registers except r11 and the
;; vector registers, and the callee saves the registers it uses.
function %caller(i64, i64, i64, i64, i64) -> i64 {
    sig0 = (i64) preserve_most
    fn0 = %callee sig0
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    call fn0(v0)
    v5 = iadd v0, v1
    v6 = iadd v2, v3
    v7 = iadd v5, v6
    v8 = iadd v7, v4
    return v8
}

